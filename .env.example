# Values marked "1Password" live in AimHigher/aimhigher-cms: in .env, set them to
# op://AimHigher/aimhigher-cms/<KEY> and scripts/with-env.sh resolves them.

HOST=
PORT=

# 1Password
APP_KEYS=
API_TOKEN_SALT=
TRANSFER_TOKEN_SALT=
ENCRYPTION_KEY=
ADMIN_JWT_SECRET=
JWT_SECRET=

# Database (1Password): postgres (Neon) or sqlite
DATABASE_CLIENT=
DATABASE_URL=
# Not a secret: set directly (true for Neon)
DATABASE_SSL=

# Azure blob storage for uploads (1Password; leave empty to store in public/uploads)
STORAGE_ACCOUNT=
STORAGE_ACCOUNT_KEY=
STORAGE_CONTAINER_NAME=
STORAGE_URL=

# Optional integrations (1Password; disabled when empty)
SENDGRID_API_KEY=
SENTRY_DSN=

# Temporary: old v3 MongoDB, only for the data migration. Remove after cutover.
AUTHENTICATION_MONGO=
MONGO_HOST=
MONGO_NAME=
MONGO_PASSWORD=
MONGO_PORT=
MONGO_SRV=
MONGO_SSL=
MONGO_USERNAME=
