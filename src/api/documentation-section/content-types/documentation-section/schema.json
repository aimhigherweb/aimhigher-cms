    },
    "technologies": {
      "type": "relation",
      "target": "api::technology.technology",
      "relation": "manyToMany",
      "mappedBy": "documentation_sections"
    },
    "docs": {
      "type": "relation",
      "target": "api::doc.doc",
      "relation": "oneToMany",
      "mappedBy": "section"
    }
  }
