{
  "kind": "collectionType",
  "collectionName": "docs",
  "info": {
    "singularName": "doc",
    "pluralName": "docs",
    "displayName": "Docs"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string"
    },
    "slug": {
      "type": "uid",
      "targetField": "title"
    },
    "update": {
      "type": "date"
    },
    "clients": {
      "type": "relation",
      "target": "api::client.client",
      "relation": "manyToMany",
      "inversedBy": "docs"
    },
    "content": {
      "type": "richtext"
    },
    "section": {
      "type": "relation",
      "target": "api::documentation-section.documentation-section",
      "relation": "manyToOne",
      "inversedBy": "docs"
    }
  }
}
