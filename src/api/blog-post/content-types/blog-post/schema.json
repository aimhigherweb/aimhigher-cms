{
  "kind": "collectionType",
  "collectionName": "posts",
  "info": {
    "singularName": "blog-post",
    "pluralName": "blog-posts",
    "displayName": "Blog Posts"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "title",
      "required": true
    },
    "description": {
      "type": "text"
    },
    "date": {
      "type": "date"
    },
    "featured": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images"
      ]
    },
    "content": {
      "type": "richtext"
    },
    "author": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::author.author",
      "inversedBy": "blog_posts"
    },
    "categories": {
      "type": "string"
    },
    "canonical": {
      "type": "string"
    },
    "cta": {
      "type": "enumeration",
      "enum": [
        "generic_form",
        "none",
        "book_a_call"
      ],
      "default": "generic_form"
    }
  }
}
